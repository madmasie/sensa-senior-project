# ── PlatformIO ────────────────────────────────────────────────────────────────
.pio

# ── VS Code ───────────────────────────────────────────────────────────────────
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/
env/

# ── Sensor data files ─────────────────────────────────────────────────────────
# Raw SEN55 recording sessions from uart_logger.py.
# These are large binary files that do not belong in version control.
# Use data_uploader.py / data_sync.py to share data with teammates.
*.pkl

# ── ML training data and model artefacts ─────────────────────────────────────
# The data/ directories are populated by prepare_data.py and uart_logger.py.
# The models/ directories are populated by main.py / train_public.py during
# training (checkpoints, scaler, predictions.png).
# None of these are source code — they are build outputs or raw data.
/data/
tools/data/
tools/pytorch_calibration/data/
tools/pytorch_calibration/models/
tools/pytorch_calibration/models_public/
tools/sensa_tools.egg-info
# Intermediate and final model files generated during export.
# Regenerate with: python main.py --export-only
*.onnx
*.tflite
*.pt

# ── Generated figures ────────────────────────────────────────────────────────
# Plots and figures produced by the tools (paper_figures.py, training
# diagnostics, etc.) are build outputs — regenerate them, don't commit them.
*.png
*.pdf
# Exception: webapp assets that are genuine source files.
!webapp/src/assets/hero.png
# Exception: poster image sources (logos, schematics, screenshots used by poster.tex).
!poster/img/*.png
!poster/img/*.jpg
!poster/img/*.jpeg

# ── LaTeX build artefacts ────────────────────────────────────────────────────
# Auxiliary files produced by pdflatex/beamer when compiling poster/poster.tex.
# Regenerate with: pdflatex poster.tex
*.aux
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.synctex.gz
*.toc
